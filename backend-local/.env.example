# Server Port (Local)
PORT=5050

# MongoDB Connection String:
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/local_gems_explorer
# Production (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/local_gems_explorer?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URLs (comma-separated if multiple)
# Local:
CLIENT_URL=http://localhost:8080,https://local-gems-explorer-kappa.vercel.app

# Cloudinary Configuration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Node Environment (set to 'production' on Vercel)
NODE_ENV=development
